# FacePay Frontend Environment Variables
# Copy this file to .env and fill in the values

# API origin (no trailing path). Backend serves routes under /api/v1
VITE_API_URL=http://localhost:3000

# Phone / tablet on same Wi‑Fi: use your computer's LAN IP (ipconfig → IPv4), not localhost.
# Example: VITE_API_URL=http://192.168.1.105:3000
# Then add the matching UI origin to backend CORS_ORIGINS, e.g. http://192.168.1.105:5173

# --- Production (Vercel) ---
# Vercel builds pick up VITE_* from Project Settings or frontend/vercel.json build.env.
# API (Render): https://facepay-inrz.onrender.com  — no trailing slash.
# UI: https://facepay-bice.vercel.app — must also appear in backend CORS_ORIGINS on Render.

# Public URL where the app is served (used for QR code generation)
VITE_PUBLIC_URL=http://localhost:5173
# For phone testing: http://192.168.1.105:5173 (same IP as above, Vite dev port)
# Production: https://facepay-bice.vercel.app
