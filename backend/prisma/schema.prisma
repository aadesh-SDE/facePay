generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  mobile           String    @unique @db.VarChar(20)
  email            String    @unique @db.VarChar(255)
  name             String    @db.VarChar(120)
  passwordHash     String    @map("password_hash")
  avatarUrl        String?   @map("avatar_url")
  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  wallet           Wallet?
  ledgerEntries    LedgerEntry[]
  transactions     Transaction[] @relation("UserTransactions")
  sentTransfers    Transfer[]    @relation("Sender")
  receivedTransfers Transfer[]   @relation("Recipient")
  faceTemplate      FaceTemplate?
  peerTransactions  Transaction[] @relation("PeerUser")

  @@map("users")
}

model Wallet {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  balanceCents  BigInt   @default(0) @map("balance_cents")
  currency      String   @default("INR") @db.Char(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model LedgerEntry {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  changeCents      BigInt   @map("change_cents")
  balanceAfterCents BigInt  @map("balance_after_cents")
  entryType        String   @map("entry_type") @db.VarChar(32)
  transferId       String?  @map("transfer_id") @db.Uuid
  metadata         Json?    @db.JsonB
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  transfer Transfer? @relation(fields: [transferId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@map("ledger_entries")
}

model Transfer {
  id               String   @id @default(uuid()) @db.Uuid
  idempotencyKey   String   @map("idempotency_key") @db.VarChar(128)
  senderUserId     String   @map("sender_user_id") @db.Uuid
  recipientUserId  String   @map("recipient_user_id") @db.Uuid
  amountCents      BigInt   @map("amount_cents")
  note             String?  @db.VarChar(500)
  status           String   @default("completed") @db.VarChar(24)
  failureCode      String?  @map("failure_code") @db.VarChar(64)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sender    User @relation("Sender", fields: [senderUserId], references: [id])
  recipient User @relation("Recipient", fields: [recipientUserId], references: [id])

  ledgerEntries LedgerEntry[]
  transactions  Transaction[]

  @@unique([senderUserId, idempotencyKey])
  @@map("transfers")
}

model Transaction {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  direction    String   @db.VarChar(16)
  title        String   @db.VarChar(200)
  subtitle     String   @db.VarChar(200)
  amountCents  BigInt   @map("amount_cents")
  peerUserId   String?  @map("peer_user_id") @db.Uuid
  transferId   String?  @map("transfer_id") @db.Uuid
  icon         String?  @db.VarChar(64)
  note         String?  @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User      @relation("UserTransactions", fields: [userId], references: [id], onDelete: Cascade)
  peer     User?     @relation("PeerUser", fields: [peerUserId], references: [id], onDelete: SetNull)
  transfer Transfer? @relation(fields: [transferId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@map("transactions")
}

model FaceTemplate {
  userId             String   @id @map("user_id") @db.Uuid
  ciphertext         Bytes
  algorithmVersion   String   @map("algorithm_version") @db.VarChar(32)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("face_templates")
}
