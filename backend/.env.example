PORT=3000
# Neon: Dashboard → Connection string → URI (include ?sslmode=require). Never commit real .env.
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX.region.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=change-me-min-16-chars-for-dev-only
JWT_EXPIRES_IN=7d
FACE_TEMPLATE_ENCRYPTION_KEY=change-me-32-chars-minimum!!
# Every browser origin that calls this API (comma-separated, no spaces after commas optional).
# Include LAN origins when testing from a phone (same Wi‑Fi), e.g. http://192.168.1.105:5173
# On Render: set the same value; include your Vercel URL(s) and any preview URLs you use.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://facepay-bice.vercel.app
