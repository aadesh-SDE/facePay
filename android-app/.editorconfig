# Kotlin / Android — aligns with kotlin.code.style=official and ktlint.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
ij_kotlin_allow_trailing_comma = true
# Compose + Material use PascalCase entry points; ktlint's default rule fights the framework.
ktlint_standard_function-naming = disabled
