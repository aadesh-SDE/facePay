# Copy to .env locally if you use a env loader; Expo also reads EXPO_PUBLIC_* at bundling time.
# Android emulator → machine localhost:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
# Physical phone on same Wi‑Fi as dev machine:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:3000

EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000

# Optional (Phase 5): enable Sentry crash reporting when DSN is set
# EXPO_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx

# EAS: after `eas init`, Expo may add project id to app config; for Sentry source maps on EAS Build:
# SENTRY_AUTH_TOKEN= (org token from sentry.io — set in EAS Secrets, not in .env committed to git)
